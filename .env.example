# URL base del backend NestJS (ver ../backend).
VITE_API_URL=/api
# Backend al que reenvía /api el servidor de desarrollo de Vite (por defecto http://localhost:3000).
# API_PROXY_TARGET=https://<tu-servicio>.run.app
# true  = demo aislada: los servicios usan la capa mock (localStorage), sin backend.
# false = los servicios usan Axios contra VITE_API_URL (requiere MongoDB + backend).
VITE_USE_MOCKS=true

# PostHog browser analytics.
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
